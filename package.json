{
  "name": "cymor-music-downloader",
  "version": "2.0.0",
  "description": "Elite MP3 & MP4 Music Downloader built by Legendary Smiley Cymor",

  "main": "server.js",

  "keywords": [
    "cymor",
    "music",
    "downloader",
    "mp3",
    "mp4",
    "youtube",
    "audio",
    "video",
    "ffmpeg",
    "cymortechservices"
  ],

  "author": "Legendary Smiley Cymor",
  "license": "MIT",

  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm install",
    "serve": "node server.js",

    "preinstall": "mkdir -p bin",
    "postinstall": "curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o bin/yt-dlp && chmod +x bin/yt-dlp"
  },

  "dependencies": {
    "@distube/ytdl-core": "^4.15.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "yt-search": "^2.11.1",
    "yt-dlp-exec": "^1.0.2"
  },

  "devDependencies": {
    "nodemon": "^3.1.0"
  },

  "engines": {
    "node": ">=18.0.0"
  }
}
