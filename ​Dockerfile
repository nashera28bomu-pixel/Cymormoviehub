# --- Stage 1: Python Builder ---
FROM python:3.10-slim AS python-build
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --target=/app/deps -r requirements.txt

# --- Stage 2: Final Image ---
FROM node:18-slim
WORKDIR /app

# Install system essentials
RUN apt-get update && apt-get install -y python3 python3-pip supervisor && rm -rf /var/lib/apt/lists/*

# Copy Python deps and code
COPY --from=python-build /app/deps /usr/local/lib/python3.10/dist-packages
COPY backend /app/backend

# Copy Node code
COPY frontend /app/frontend
WORKDIR /app/frontend
RUN npm install --production

# Supervisor Config (Multi-process management)
RUN printf "[supervisord]\nnodaemon=true\n\n[program:python_engine]\ncommand=python3 /app/backend/app.py\nautostart=true\nautorestart=true\n\n[program:node_server]\ncommand=node /app/frontend/server.js\nautostart=true\nautorestart=true\n" > /etc/supervisor/conf.d/supervisord.conf

EXPOSE 3000
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
